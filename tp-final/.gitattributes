# Fin de línea LF (Linux) en todos los archivos de texto del TP, aunque se
# editen desde Windows. Un script .sh con CRLF falla en Ubuntu con
# "/usr/bin/env: 'bash\r': No such file or directory".
* text=auto eol=lf

# Binarios: no tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.webm binary
*.pdf binary
*.pptx binary
*.docx binary
